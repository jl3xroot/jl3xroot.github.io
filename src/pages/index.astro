---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import IconRss from "@/assets/icons/IconRss.svg";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Socials from "@/components/Socials.astro";
import Card from "@/components/Card.astro";
import LinkButton from "@/components/LinkButton.astro";
import { getSortedPosts } from "@/utils/getSortedPosts";
import { useTranslations } from "@/i18n";
import config from "@/config";

const { socials } = config;

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);

const posts = await getCollection("posts");
const sortedPosts = getSortedPosts(posts);
const featuredPosts = sortedPosts.filter(({ data }) => data.featured);
const recentPosts = sortedPosts.filter(({ data }) => !data.featured);
const homePath = getRelativeLocaleUrl(locale, "");
---

<Layout>
  <Header />
  <main
    id="main-content"
    data-layout="index"
    data-home-path={homePath}
    class="app-layout flex h-[calc(100dvh-73px)] flex-col justify-between overflow-hidden py-2 sm:h-[calc(100dvh-89px)] sm:py-3"
  >
    <section
      id="hero"
      class="border-border shrink-0 border-b pb-2 sm:pb-2.5"
    >
      <div class="rounded-md border border-border bg-muted/60 p-3 sm:p-4">
        <div class="flex items-center justify-between gap-2">
          <p
            class="text-accent font-medium"
            style="font-size: clamp(0.72rem, 1.5vw, 0.875rem);"
          >
            jl3x@netops:~$
            <span class="bg-accent inline-block h-3.5 w-2 align-middle"></span>
          </p>
          <a
            target="_blank"
            href={`${import.meta.env.BASE_URL.replace(/\/?$/, "/")}rss.xml`}
            class="text-muted-foreground hover:text-accent inline-flex items-center gap-1 text-xs"
            aria-label="RSS Feed"
            title="RSS Feed"
          >
            <IconRss
              width={15}
              height={15}
              class="stroke-accent scale-110 stroke-2 rtl:-rotate-90"
            />
            <span>RSS</span>
          </a>
        </div>

        <h1
          class="text-foreground mt-1.5 font-bold tracking-tight sm:mt-2"
          style="font-size: clamp(1.2rem, 3.2vw, 2rem); line-height: 1.15;"
        >
          <span class="text-accent">&gt;_</span> jl3x | NetOps &amp; Sec
        </h1>

        <p
          class="text-muted-foreground mt-1"
          style="font-size: clamp(0.7rem, 1.4vw, 0.85rem);"
        >
          Redes <span class="text-accent">&bull;</span> Observabilidade{" "}
          <span class="text-accent">&bull;</span> Automação{" "}
          <span class="text-accent">&bull;</span> Sec
        </p>
      </div>

      <p
        class="mt-2 leading-snug sm:mt-2.5"
        style="font-size: clamp(0.78rem, 1.6vw, 0.92rem);"
      >
        Write-ups técnicos, notas de laboratório, troubleshooting de rede,
        monitoramento e automações aplicadas à operação e segurança.
      </p>

      {
        socials.length > 0 && (
          <div
            class="mt-2 flex flex-wrap items-center gap-2"
            style="font-size: clamp(0.72rem, 1.4vw, 0.85rem);"
          >
            <div class="text-muted-foreground whitespace-nowrap">
              {t.home.socialLinks}:
            </div>
            <Socials />
          </div>
        )
      }
    </section>

    <div class="flex min-h-0 flex-1 flex-col justify-evenly overflow-hidden py-1">
      {
        featuredPosts.length > 0 && (
          <section
            id="featured"
            class:list={[
              "min-h-0 py-1.5",
              { "border-border border-b": recentPosts.length > 0 },
            ]}
          >
            <h2
              class="font-semibold tracking-wide"
              style="font-size: clamp(0.95rem, 2vw, 1.2rem);"
            >
              {t.home.featured}
            </h2>
            <ul class="[&>li]:my-1 [&>li>a]:py-1">
              {featuredPosts.slice(0, 1).map(data => (
                <Card variant="h3" {...data} />
              ))}
            </ul>
          </section>
        )
      }

      {
        recentPosts.length > 0 && (
          <section id="recent-posts" class="min-h-0 py-1.5">
            <h2
              class="font-semibold tracking-wide"
              style="font-size: clamp(0.95rem, 2vw, 1.2rem);"
            >
              {t.home.recentPosts}
            </h2>
            <ul class="[&>li]:my-1 [&>li>a]:py-1">
              {recentPosts.slice(0, 2).map(data => (
                <Card variant="h3" {...data} />
              ))}
            </ul>
          </section>
        )
      }
    </div>

    <div class="shrink-0 pt-1.5 pb-1 text-center">
      <LinkButton
        href={getRelativeLocaleUrl(locale, "posts")}
        class="text-xs sm:text-sm"
      >
        {t.home.allPosts}
        <IconArrowRight class="inline-block rtl:-rotate-180" />
      </LinkButton>
    </div>
  </main>
  <Footer />
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)
      ?.dataset;
    const baseRoot = import.meta.env.BASE_URL.replace(/\/?$/, "/");
    if (indexLayout?.layout) {
      sessionStorage.setItem("backUrl", indexLayout.homePath ?? baseRoot);
    }
  });
</script>
