---
import { Font } from "astro:assets";
import { ClientRouter } from "astro:transitions";
import { resolveDefaultOgImagePath } from "@/utils/resolveDefaultOgImagePath";
import { getAssetPath } from "@/utils/withBase";
import config from "@/config";
import "@/styles/global.css";
import CustomHead from "@/custom/Head.astro";
import CustomBodyEnd from "@/custom/BodyEnd.astro";

type Props = {
  title?: string;
  description?: string;
  ogImage?: string;
  canonicalURL?: string;
};

const { site } = config;

const {
  title = site.title,
  description = site.description,
  ogImage = resolveDefaultOgImagePath(config),
  canonicalURL = new URL(Astro.url.pathname, Astro.site).href,
} = Astro.props;

const socialImageURL = new URL(ogImage, Astro.site ?? Astro.url);
const rssHref = getAssetPath("rss.xml");
---

<!doctype html>
<html
  dir={site.dir ?? "ltr"}
  lang={Astro.currentLocale ?? site.lang}
  class="dark overflow-y-scroll scroll-smooth"
  data-theme="dark"
>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" href={getAssetPath("favicon.png")} />
    <link rel="icon" href={getAssetPath("favicon.ico")} />
    <link rel="canonical" href={canonicalURL} />
    <meta name="generator" content={Astro.generator} />

    <!-- Font -->
    <Font
      cssVariable="--font-google-sans-code"
      preload={[{ subset: "latin", weight: 400, style: "normal" }]}
    />

    <!-- Primary meta -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="author" content={site.author} />
    <link rel="sitemap" href={getAssetPath("sitemap-index.xml")} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.title} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={socialImageURL} />

    <!-- Twitter / X -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={socialImageURL} />

    <!-- RSS autodiscovery -->
    <link
      rel="alternate"
      type="application/rss+xml"
      title={site.title}
      href={new URL(rssHref, Astro.site)}
    />

    <!-- Filled at runtime by theme.ts to match the current background colour -->
    <meta name="theme-color" content="rgb(13, 16, 21)" />

    <!-- Extra head content injected by child layouts (e.g. JSON-LD, article meta) -->
    <slot name="head" />

    {
      site.googleVerification && (
        <meta
          name="google-site-verification"
          content={site.googleVerification}
        />
      )
    }

    <!--
      Inline FOUC-prevention script: enforces dark theme before paint.
    -->
    <script is:inline>
      (function () {
        const theme = "dark";
        try {
          localStorage.setItem("theme", theme);
        } catch {}
        const root = document.documentElement;
        root.setAttribute("data-theme", theme);
        root.classList.add("dark");
        window.__theme = { value: theme };
      })();
    </script>

    <ClientRouter />

    <CustomHead {title} {description} />
  </head>
  <body
    class="bg-background font-app text-foreground selection:bg-accent/75 selection:text-accent-foreground flex min-h-svh flex-col"
  >
    <div
      id="netops-preloader"
      aria-hidden="true"
      class="bg-background fixed inset-0 z-50 flex items-center justify-center px-4 transition-opacity duration-200"
    >
      <div
        class="border-border bg-muted/80 w-full max-w-lg rounded-md border p-5 shadow-lg sm:p-6"
      >
        <div
          class="border-border/60 text-muted-foreground mb-3 flex items-center gap-2 border-b pb-2 text-xs"
        >
          <span class="bg-accent/80 inline-block h-2.5 w-2.5 rounded-full"
          ></span>
          <span>tty1 — session</span>
        </div>

        <p class="text-accent font-mono text-sm font-medium sm:text-base">
          <span>jl3x@netops:~$</span>
        </p>

        <p
          id="type-banner-wrap"
          class="text-foreground mt-2 font-mono text-xl font-bold tracking-tight sm:text-3xl"
        >
          <span class="text-accent select-none">&gt;</span><span
            id="type-banner"
          ></span><span
            id="cursor-underscore"
            class="text-accent animate-pulse font-bold"
            >_</span
          >
        </p>
      </div>
    </div>

    <slot />

    <script is:inline>
      (function () {
        const TYPED_TEXT = " access granted";

        let activeTimer = null;
        let hideTimer = null;
        let safetyTimer = null;

        function clearAllTimers() {
          if (activeTimer) clearTimeout(activeTimer);
          if (hideTimer) clearTimeout(hideTimer);
          if (safetyTimer) clearTimeout(safetyTimer);
          activeTimer = null;
          hideTimer = null;
          safetyTimer = null;
        }

        function hidePreloader(preloader) {
          if (!preloader) return;
          preloader.classList.add("opacity-0", "pointer-events-none");
          hideTimer = setTimeout(() => {
            preloader.classList.add("hidden");
          }, 200);
        }

        function typeString(el, text, speed, onDone) {
          let i = 0;
          el.textContent = "";

          function step() {
            if (i < text.length) {
              el.textContent += text.charAt(i);
              i += 1;
              activeTimer = setTimeout(step, speed);
            } else if (onDone) {
              onDone();
            }
          }

          step();
        }

        function runPreloader() {
          clearAllTimers();

          const preloader = document.getElementById("netops-preloader");
          const bannerEl = document.getElementById("type-banner");

          if (!preloader || !bannerEl) return;

          const reducedMotion = window.matchMedia(
            "(prefers-reduced-motion: reduce)"
          ).matches;

          preloader.classList.remove(
            "hidden",
            "opacity-0",
            "pointer-events-none"
          );
          bannerEl.textContent = "";

          if (reducedMotion) {
            bannerEl.textContent = TYPED_TEXT;
            activeTimer = setTimeout(() => hidePreloader(preloader), 150);
            return;
          }

          safetyTimer = setTimeout(() => {
            clearAllTimers();
            hidePreloader(preloader);
          }, 2200);

          activeTimer = setTimeout(() => {
            typeString(bannerEl, TYPED_TEXT, 28, () => {
              activeTimer = setTimeout(() => {
                if (safetyTimer) clearTimeout(safetyTimer);
                hidePreloader(preloader);
              }, 200);
            });
          }, 100);
        }

        document.addEventListener("astro:page-load", runPreloader);
        if (document.readyState !== "loading") {
          runPreloader();
        } else {
          document.addEventListener("DOMContentLoaded", runPreloader, {
            once: true,
          });
        }
      })();
    </script>

    <script>
      import "@/scripts/theme";
    </script>
    <CustomBodyEnd />
  </body>
</html>
